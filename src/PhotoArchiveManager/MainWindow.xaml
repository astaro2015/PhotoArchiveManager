                                    <MenuItem Header="Оставить выбранный" Command="{Binding SetVisualKeeperCommand}"/>
                                    <MenuItem Header="Сбросить ручные отметки" Command="{Binding ClearVisualReviewCommand}"/>
                                    <Separator/>
