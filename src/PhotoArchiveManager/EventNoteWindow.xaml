<Window x:Class="PhotoArchiveManager.EventNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметка к событию" Icon="Assets/PhotoArchiveManager.ico"
        Width="620" MinWidth="480" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Короткая заметка о событии" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBox x:Name="NoteBox" Grid.Row="1" MinHeight="130" MaxHeight="340" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" MinWidth="110"/>
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click" MinWidth="120" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
