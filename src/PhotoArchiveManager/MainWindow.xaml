                                    <MenuItem Header="Оставить" IsCheckable="True" IsChecked="{Binding SelectedVisualDuplicateFile.IsManualKeeper, Mode=TwoWay}"/>
                                    <MenuItem Header="В карантин" IsCheckable="True" IsChecked="{Binding SelectedVisualDuplicateFile.IsMarkedForQuarantine, Mode=TwoWay}" IsEnabled="{Binding SelectedVisualDuplicateFile.CanMarkForQuarantine}"/>
                                    <Separator/>
                                    <MenuItem Header="Сравнить 2–8 кадров" Click="CompareVisual_Click"/>
