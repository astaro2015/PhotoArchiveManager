<Window x:Class="PhotoArchiveManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PhotoArchiveManager.Converters"
        xmlns:models="clr-namespace:PhotoArchiveManager.Models"
        Title="Photo Archive Manager · 1.7.1"
        Icon="Assets/PhotoArchiveManager.ico"
        Width="1560" Height="940" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:FilePathToBitmapConverter x:Key="ImageConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <DockPanel Background="{StaticResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Photo Archive Manager" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,24,0"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Обновить текущий список · F5"/>
                    <Button Content="Справка" Click="Help_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Открыть справку Photo Archive Manager · F1"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Добавить папку" Click="AddFolder_Click" ToolTip="Добавить источник фотографий · Ctrl+O"/>
                    <Button Content="Сканировать" Command="{Binding StartScanCommand}" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Сканировать источники · F9"/>
                    <Border Width="1" Height="22" Background="{StaticResource SeparatorBrush}" Margin="8,0"/>
                    <Button Content="Пауза" Command="{Binding PauseCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Продолжить" Command="{Binding ResumeCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Стоп" Command="{Binding StopCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceSecondaryBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="14,5">
            <DockPanel>
                <TextBlock Text="Оригиналы защищены" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" Margin="0,0,10,0"/>
                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip="Перед физической организацией PAM всегда строит Preview БЫЛО → СТАНЕТ. Перемещение требует двух подтверждений, проверяется SHA-256 и записывается в журнал Undo. Файлы не перезаписываются. Окончательное удаление скрыто в настройках и требует двух подтверждений."
                           Text="Изменения каталога не затрагивают файлы · физические операции — только через Preview, проверки SHA-256 и Undo"/>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="820" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ScanCountersText}" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DataPathText}" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Style="{StaticResource SidebarTabControlStyle}" ItemContainerStyle="{StaticResource SidebarTabItemStyle}" SelectedIndex="{Binding SelectedMainTabIndex}">
            <TabItem Header="Библиотека" ToolTip="Библиотека · Ctrl+1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="215"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                        <ColumnDefinition Width="330" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0" Background="{StaticResource PanelBrush}" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Источники" Style="{StaticResource SectionLabelStyle}" Margin="3,3,3,8"/>
                                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Height="145" Margin="2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="3,3,3,8">
                                    <Button Content="Убрать" Click="RemoveSource_Click" IsEnabled="{Binding CanManageSelectedSource}" ToolTip="Убирает выбранную папку только из PAM. Исходные файлы на диске никогда не удаляются."/>
                                    <Button Content="Заменить путь" Click="ReplaceSource_Click" IsEnabled="{Binding CanManageSelectedSource}" ToolTip="Если папка/диск переехали — заменяет корневой путь в каталоге PAM, сохраняя рассчитанные данные."/>
                                </WrapPanel>

                                <Separator Margin="3,12"/>
                                <TextBlock Text="Фильтры" Style="{StaticResource SectionLabelStyle}" Margin="3,3,3,8"/>
                                <TextBlock Text="Имя / путь" Margin="3,2"/>
                                <TextBox x:Name="LibrarySearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по имени и пути · Ctrl+F · Enter — применить фильтры"/>
                                <TextBlock Text="Год" Margin="3,7,3,2"/>
                                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"/>
                                <TextBlock Text="Камера" Margin="3,7,3,2"/>
                                <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"/>
                                <CheckBox Content="Только избранное" IsChecked="{Binding ShowFavoritesOnly}" Margin="4,9,3,3"/>
                                <DockPanel Margin="3,4,3,0">
                                    <TextBlock Text="Рейтинг от" VerticalAlignment="Center"/>
                                    <ComboBox DockPanel.Dock="Right" Width="70" ItemsSource="{Binding RatingFilterOptions}" SelectedItem="{Binding SelectedMinRating}" ToolTip="0 — любой рейтинг"/>
                                </DockPanel>
                                <Button Content="Применить фильтры" Command="{Binding ApplyFiltersCommand}" Margin="3,10,3,3" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="Сбросить" Command="{Binding ResetFiltersCommand}"/>

                                <Separator Margin="3,12"/>
                                <TextBlock Text="Каталог" Style="{StaticResource SectionLabelStyle}" Margin="3,3,3,8"/>
                                <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" LineHeight="21" Margin="3"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="12,9" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding ListHeaderText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LoadedText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="LibraryPhotosList" ItemsSource="{Binding Photos}" SelectedItem="{Binding SelectedPhoto}" SelectionMode="Extended" MouseDoubleClick="PhotoList_MouseDoubleClick" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                                     ScrollViewer.IsDeferredScrollingEnabled="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     BorderThickness="0">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Просмотр" Click="OpenViewer_Click"/>
                                    <MenuItem Header="Показать в Проводнике" Command="{Binding ShowInExplorerCommand}"/>
                                    <MenuItem Header="Открыть" Command="{Binding OpenPhotoCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding SelectedPhoto.FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}"/>
                                    <MenuItem Header="Рейтинг">
                                        <MenuItem Header="1 ★" Tag="1" Click="Rating_Click"/>
                                        <MenuItem Header="2 ★" Tag="2" Click="Rating_Click"/>
                                        <MenuItem Header="3 ★" Tag="3" Click="Rating_Click"/>
                                        <MenuItem Header="4 ★" Tag="4" Click="Rating_Click"/>
                                        <MenuItem Header="5 ★" Tag="5" Click="Rating_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Сбросить рейтинг" Tag="0" Click="Rating_Click"/>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Изменить дату выбранных…" Click="BatchDate_Click"/>
                                    <MenuItem Header="Назначить выбранным событие…" Click="BatchEvent_Click"/>
                                    <MenuItem Header="Исправить дату…" Command="{Binding EditPhotoCaptureDateCommand}"/>
                                    <MenuItem Header="Вернуть автоматическую дату" Command="{Binding ResetPhotoCaptureDateCommand}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="7,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="124"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="145"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="104" Height="74" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=240}" Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,2">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding CameraDisplay}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="5,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CaptureDateDisplay}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DimensionsDisplay}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding FileSizeDisplay}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding RatingStars}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding FavoriteDisplay}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" FontSize="16"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Photos.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Здесь появятся фотографии" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Добавьте папку слева и запустите сканирование. PAM индексирует архив, не изменяя оригиналы."
                                           Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8">
                            <Button Content="Загрузить ещё" Command="{Binding LoadMoreCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceSecondaryBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">
                                <TextBlock Text="Просмотр" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                                <Border Height="280" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                    <Image Source="{Binding SelectedPhoto.FullPath, Converter={StaticResource ImageConverter}, ConverterParameter=1200}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedPhoto.FileName}" Style="{StaticResource InspectorHeaderStyle}"/>
                                <TextBlock Text="{Binding SelectedPhoto.FullPath}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата:" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPhoto.CaptureDateDisplay}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Размер:" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPhoto.DimensionsDisplay}" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Файл:" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPhoto.FileSizeDisplay}" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Камера:" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPhoto.CameraDisplay}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Источник даты:" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPhoto.CaptureDateSource}" Margin="0,7,0,0"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Просмотр" Click="OpenViewer_Click" ToolTip="Полноэкранный просмотр · Space" Style="{StaticResource PrimaryButtonStyle}"/>
                                    <Button Content="Показать в Проводнике" Command="{Binding ShowInExplorerCommand}"/>
                                    <Button Content="Открыть" Command="{Binding OpenPhotoCommand}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{Binding SelectedPhoto.FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}" ToolTip="Избранное хранится только в каталоге PAM"/>
                                    <TextBlock Text="{Binding SelectedPhoto.RatingDisplay}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="1★" Tag="1" Click="Rating_Click" Padding="8,4" ToolTip="Рейтинг 1 из 5"/>
                                    <Button Content="2★" Tag="2" Click="Rating_Click" Padding="8,4"/>
                                    <Button Content="3★" Tag="3" Click="Rating_Click" Padding="8,4"/>
                                    <Button Content="4★" Tag="4" Click="Rating_Click" Padding="8,4"/>
                                    <Button Content="5★" Tag="5" Click="Rating_Click" Padding="8,4"/>
                                    <Button Content="Сброс" Tag="0" Click="Rating_Click" Padding="8,4"/>
                                </WrapPanel>

                                <Separator Margin="0,12,0,8"/>
                                <TextBlock Text="Для выделенных фото" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,5"/>
                                <Button Content="Изменить дату выбранных…" Click="BatchDate_Click" ToolTip="Ctrl/Shift: выделите несколько фото · Ctrl+Shift+D. Меняется только каталог PAM."/>
                                <Button Content="Назначить выбранным событие…" Click="BatchEvent_Click" ToolTip="Ctrl+Shift+E · Связывает выделенные фото с существующим событием только в SQLite."/>
                                <TextBlock Text="Ctrl/Shift — множественное выделение." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="3,3,3,8"/>

                                <Separator Margin="0,8,0,8"/>
                                <TextBlock Text="Дата в каталоге" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,5"/>
                                <Button Content="Исправить дату…" Command="{Binding EditPhotoCaptureDateCommand}" FontWeight="SemiBold"
                                        ToolTip="Меняет только дату в SQLite-каталоге PAM. EXIF и оригинальный файл не изменяются."/>
                                <Button Content="Вернуть автоматическую дату" Command="{Binding ResetPhotoCaptureDateCommand}"
                                        ToolTip="Доступно после ручной коррекции. Возвращает дату, найденную сканером, без изменения файла."/>
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="3,5,3,0"
                                           Text="Ручная дата переживает пересканирование и участвует в событиях и Preview. После изменения пересоберите автособытия."/>

                                <TextBlock Text="{Binding SelectedPhoto.Error}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Точные дубли" ToolTip="Точные дубли · Ctrl+2">
                <Grid Background="{StaticResource AppBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Найти точные дубли" Command="{Binding FindExactDuplicatesCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="Пауза" Command="{Binding PauseDuplicateAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Продолжить" Command="{Binding ResumeDuplicateAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Стоп" Command="{Binding StopDuplicateAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Separator Width="12" Opacity="0"/>
                                <Button Content="Обновить результаты" Command="{Binding RefreshDuplicatesCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Мастер разбора…" Click="DuplicateWizard_Click" ToolTip="Рекомендует экземпляр, который оставить, для каждой SHA-256 группы"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DuplicateProgressText}" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="15,0,5,0"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="{Binding DuplicateSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="Группа подтверждена одинаковым размером и полным SHA-256. Выберите экземпляр, который оставить; остальные можно отправить в карантин."/>
                            <DockPanel LastChildFill="False" Margin="0,7,0,0">
                                <TextBlock Text="{Binding DuplicateReviewStatusText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="‹" Command="{Binding PreviousDuplicateGroupCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Предыдущая группа · Alt+←"/>
                                    <Button Content="{Binding DuplicateReviewActionText}" Command="{Binding ToggleDuplicateReviewedCommand}" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Переключить отметку «обработано» · Ctrl+Enter"/>
                                    <Button Content="›" Command="{Binding NextDuplicateGroupCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Следующая группа · Alt+→"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="250"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                            <ColumnDefinition Width="330" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0" Background="{StaticResource PanelBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Группы дублей" Style="{StaticResource SectionLabelStyle}" Margin="12,10,12,8"/>
                                <ListBox ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedDuplicateGroup}"
                                         BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="9,7">
                                                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SubheaderText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding HashShort}" FontFamily="Consolas" Foreground="{StaticResource TertiaryTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="12,9" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedDuplicateGroup.HeaderText}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedDuplicateGroup.SubheaderText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="DuplicateFilesList" Grid.Row="1" ItemsSource="{Binding SelectedDuplicateGroup.Files}" SelectedItem="{Binding SelectedDuplicateFile}" MouseDoubleClick="PhotoList_MouseDoubleClick" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                                     BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Просмотр" Click="OpenViewer_Click"/>
                                        <MenuItem Header="Показать в Проводнике" Command="{Binding ShowDuplicateInExplorerCommand}"/>
                                        <MenuItem Header="Открыть" Command="{Binding OpenDuplicateFileCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Оставить этот · остальные в карантин" Command="{Binding QuarantineOtherCopiesCommand}" Style="{StaticResource DangerMenuItemStyle}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="112"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="104" Height="74" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=220}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="7,1">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding CameraDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
