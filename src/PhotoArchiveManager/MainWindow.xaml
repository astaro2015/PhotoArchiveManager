                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Рекомендовать оставить:" VerticalAlignment="Center" Margin="3,0,5,0"/>
                                        <ComboBox Width="60" ItemsSource="{Binding BurstKeepCountOptions}" SelectedItem="{Binding SelectedBurstKeepCount}"/>
                                    </StackPanel>
                                    <Button Content="Принять рекомендацию" Command="{Binding ApplyBurstRecommendationCommand}" FontWeight="SemiBold" Margin="3,5,3,2"/>
                                    <Button Content="Отметить остальные в карантин" Command="{Binding MarkBurstOthersCommand}" Margin="3,2"/>
                                    <Button Content="В карантин отмеченные" Command="{Binding QuarantineMarkedBurstCommand}" FontWeight="SemiBold" Margin="3,2" Style="{StaticResource DangerButtonStyle}"/>
                                    <Button Content="Сбросить ручные отметки" Command="{Binding ClearBurstReviewCommand}" Margin="3,2"/>

                                    <Border Style="{StaticResource SuccessBorderStyle}" Margin="0,10,0,0">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SuccessTextBrush}"
                                                   Text="Серия строится по доверенной дате, близкому времени, камере/пропорциям и визуальной близости. Windows fallback не участвует."/>
                                    </Border>
                                    <Border Style="{StaticResource WarningBorderStyle}" Margin="0,10,0,0">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}"
                                                   Text="Рекомендация только ставит галочки. Физический перенос выполняется отдельно через карантин."/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Люди" ToolTip="Люди · Ctrl+5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="9,7">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Индексировать лица" Command="{Binding AnalyzePeopleCommand}" FontWeight="SemiBold" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="Пауза" Command="{Binding PausePeopleAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Продолжить" Command="{Binding ResumePeopleAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Стоп" Command="{Binding StopPeopleAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Separator Width="12" Opacity="0"/>
                                <TextBlock Text="Порог:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="68" ItemsSource="{Binding PeopleThresholdOptions}" SelectedItem="{Binding SelectedPeopleThreshold}"/>
                                <TextBlock Text="Мин. лиц:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <ComboBox Width="58" ItemsSource="{Binding PeopleMinGroupSizeOptions}" SelectedItem="{Binding SelectedPeopleMinGroupSize}"/>
                                <Button Content="Сгруппировать" Command="{Binding GroupPeopleCommand}" FontWeight="SemiBold" Margin="8,3,3,3" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="Обновить" Command="{Binding RefreshPeopleCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PeopleProgressText}" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="12,0,4,0"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="11,7">
                        <StackPanel>
                            <TextBlock Text="{Binding PeopleSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="Распознавание локальное. Автогруппы — предложения; названные вручную группы не пересобираются автоматически. Лицо можно перетащить на другую группу слева."/>
                            <DockPanel LastChildFill="False" Margin="0,7,0,0">
                                <TextBlock Text="{Binding PeopleReviewStatusText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="‹" Command="{Binding PreviousPersonGroupCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Предыдущая группа людей · Alt+←"/>
                                    <Button Content="{Binding PeopleReviewActionText}" Command="{Binding TogglePersonReviewedCommand}" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Переключить отметку «обработано» · Ctrl+Enter"/>
                                    <Button Content="›" Command="{Binding NextPersonGroupCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Следующая группа людей · Alt+→"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" MinWidth="245"/>
                            <ColumnDefinition Width="*" MinWidth="380"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="340" MinWidth="280"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="PersonGroupsList" Grid.Column="0" ItemsSource="{Binding PersonGroups}" SelectedItem="{Binding SelectedPersonGroup}" AllowDrop="True" PreviewDragOver="PersonGroupsList_PreviewDragOver" Drop="PersonGroupsList_Drop" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                                 BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrushSoft}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Назвать / переименовать группу" Command="{Binding RenamePersonCommand}"/>
                                    <MenuItem Header="Объединить эту группу с другой…" Command="{Binding MergePersonGroupCommand}"/>
                                    <MenuItem Header="Показать все фото человека в библиотеке" Command="{Binding ShowPersonPhotosCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Удалить / расформировать всю группу" Command="{Binding DeletePersonGroupCommand}" Style="{StaticResource DangerMenuItemStyle}"/>
                                    <MenuItem Header="Игнорировать всю группу…" Command="{Binding IgnorePersonGroupCommand}"/>
                                    <MenuItem Header="Восстановить последнее игнорирование" Command="{Binding UndoLastFaceIgnoreCommand}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="64" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                            <Image Source="{Binding RepresentativeThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=180}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,4,2,2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CountDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="PersonFacesList" Grid.Column="1" ItemsSource="{Binding PersonFaces}" SelectedItem="{Binding SelectedPersonFace}" MouseDoubleClick="PhotoList_MouseDoubleClick" PreviewMouseLeftButtonDown="PersonFacesList_PreviewMouseLeftButtonDown" PreviewMouseMove="PersonFacesList_PreviewMouseMove" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                                 BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Просмотр" Click="OpenViewer_Click"/>
                                    <MenuItem Header="Проводник" Command="{Binding ShowPersonFaceInExplorerCommand}"/>
                                    <MenuItem Header="Открыть фото" Command="{Binding OpenPersonPhotoCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Сделать выбранное лицо обложкой" Command="{Binding SetPersonCoverCommand}"/>
                                    <MenuItem Header="Назначить выбранное лицо другому человеку…" Command="{Binding AssignFaceToPersonCommand}"/>
                                    <MenuItem Header="Убрать это лицо из группы" Command="{Binding RemoveFaceFromPersonCommand}"/>
                                    <MenuItem Header="Это не лицо — игнорировать" Command="{Binding IgnoreFaceCommand}" Style="{StaticResource DangerMenuItemStyle}"/>
                                    <Separator/>
                                    <MenuItem Header="Назвать / переименовать группу" Command="{Binding RenamePersonCommand}"/>
                                    <MenuItem Header="Объединить эту группу с другой…" Command="{Binding MergePersonGroupCommand}"/>
                                    <MenuItem Header="Показать все фото человека в библиотеке" Command="{Binding ShowPersonPhotosCommand}"/>
                                    <MenuItem Header="Удалить / расформировать всю группу" Command="{Binding DeletePersonGroupCommand}" Style="{StaticResource DangerMenuItemStyle}"/>
                                    <MenuItem Header="Игнорировать всю группу…" Command="{Binding IgnorePersonGroupCommand}"/>
                                    <MenuItem Header="Восстановить последнее игнорирование" Command="{Binding UndoLastFaceIgnoreCommand}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="115"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="92" Height="92" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                            <Image Source="{Binding FaceThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=220}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,5">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CaptureDateDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource TertiaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding QualityDisplay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding GroupDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                      Background="{StaticResource SeparatorBrush}" Cursor="SizeWE" ToolTip="Перетащите, чтобы изменить ширину панели"/>

                        <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceSecondaryBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Выбранное лицо" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                                    <Border Width="220" Height="220" HorizontalAlignment="Center" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                        <Image Source="{Binding SelectedPersonFace.FaceThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=440}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedPersonFace.GroupDisplay}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    <TextBlock Text="{Binding SelectedPersonFace.QualityDisplay}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SelectedPersonFace.CaptureDateDisplay}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SelectedPersonFace.FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    <TextBlock Text="Исходное фото" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,6"/>
                                    <Border Height="250" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                        <Image Source="{Binding SelectedPersonFace.FullPath, Converter={StaticResource ImageConverter}, ConverterParameter=1000}" Stretch="Uniform"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Проводник" Command="{Binding ShowPersonFaceInExplorerCommand}"/>
                                        <Button Content="Открыть фото" Command="{Binding OpenPersonPhotoCommand}"/>
                                    </StackPanel>
                                    <Separator Margin="0,12,0,8"/>
                                    <TextBlock Text="{Binding SelectedPersonGroup.CoverDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="3,0,3,4"/>
                                    <Button Content="Сделать выбранное лицо обложкой" Command="{Binding SetPersonCoverCommand}" ToolTip="Меняет только обложку группы в каталоге PAM"/>
                                    <Button Content="Назвать / переименовать группу" Command="{Binding RenamePersonCommand}" FontWeight="SemiBold"/>
                                    <Button Content="Объединить эту группу с другой…" Command="{Binding MergePersonGroupCommand}"/>
                                    <Button Content="Удалить / расформировать всю группу" Command="{Binding DeletePersonGroupCommand}" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}"
                                            ToolTip="Удаляет только группу из локального каталога PAM. Все лица вернутся в «Без группы»; файлы фотографий не затрагиваются." Style="{StaticResource DangerButtonStyle}"/>
                                    <Button Content="Игнорировать всю группу…" Command="{Binding IgnorePersonGroupCommand}" ToolTip="Скрывает все лица группы только из каталога PAM. Undo сохраняет прежнюю принадлежность."/>
                                    <Button Content="Восстановить последнее игнорирование" Command="{Binding UndoLastFaceIgnoreCommand}"/>
                                    <TextBlock Text="{Binding FaceIgnoreUndoText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="3,3,3,5"/>
                                    <Separator Margin="0,7,0,5"/>
                                    <Button Content="Назначить выбранное лицо другому человеку…" Command="{Binding AssignFaceToPersonCommand}"/>
                                    <Button Content="Показать все фото человека в библиотеке" Command="{Binding ShowPersonPhotosCommand}"/>
                                    <Button Content="Убрать это лицо из группы" Command="{Binding RemoveFaceFromPersonCommand}"/>
                                    <Button Content="Это не лицо — игнорировать" Command="{Binding IgnoreFaceCommand}"/>

                                    <Border Style="{StaticResource InfoBorderStyle}" Margin="0,12,0,0">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="Все правки лиц хранятся локально в SQLite. Проверяйте автогруппы глазами: фото при переименовании, объединении и игнорировании не изменяются."/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="События" ToolTip="События · Ctrl+6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="9,7">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Построить события" Command="{Binding AnalyzeEventsCommand}" FontWeight="SemiBold" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="Пауза" Command="{Binding PauseEventAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Продолжить" Command="{Binding ResumeEventAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Стоп" Command="{Binding StopEventAnalysisCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Separator Width="12" Opacity="0"/>
                                <TextBlock Text="Обычный разрыв:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="72" ItemsSource="{Binding EventGapOptions}" SelectedItem="{Binding SelectedEventMaxGap}"/>
                                <TextBlock Text="мин" VerticalAlignment="Center" Margin="3,0,8,0"/>
                                <TextBlock Text="Мин. фото:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="58" ItemsSource="{Binding EventMinSizeOptions}" SelectedItem="{Binding SelectedEventMinSize}"/>
                                <Button Content="Обновить" Command="{Binding RefreshEventsCommand}" Margin="8,3,3,3" Style="{StaticResource ToolbarButtonStyle}"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EventProgressText}" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="12,0,4,0"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="11,7">
                        <StackPanel>
                            <TextBlock Text="{Binding EventSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="Автособытия: доверенная дата + временные разрывы, при наличии GPS и люди. Windows fallback не используется. Ручные правки закрепляют события."/>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="Drag&amp;drop: выделите фото (Ctrl/Shift) и перетащите на событие слева. Меняется только SQLite."/>
                            <DockPanel LastChildFill="False" Margin="0,7,0,0">
                                <TextBlock Text="{Binding EventReviewStatusText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="‹" Command="{Binding PreviousEventGroupCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Предыдущее событие · Alt+←"/>
                                    <Button Content="{Binding EventReviewActionText}" Command="{Binding ToggleEventReviewedCommand}" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Переключить отметку «обработано» · Ctrl+Enter"/>
                                    <Button Content="›" Command="{Binding NextEventGroupCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Следующее событие · Alt+→"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="270"/>
                            <ColumnDefinition Width="*" MinWidth="380"/>
                            <ColumnDefinition Width="350" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0" Background="{StaticResource PanelBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Архив по годам" Style="{StaticResource SectionLabelStyle}" Margin="12,10,12,6"/>
                                <TreeView x:Name="EventGroupsTree" ItemsSource="{Binding EventYears}" BorderThickness="0"
                                          AllowDrop="True" PreviewDragOver="EventGroupsTree_PreviewDragOver" Drop="EventGroupsTree_Drop"
                                          PreviewMouseRightButtonDown="EventGroupsTree_PreviewMouseRightButtonDown" ContextMenuOpening="EventGroupsTree_ContextMenuOpening"
                                          SelectedItemChanged="EventGroupsTree_SelectedItemChanged">
                                    <TreeView.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Переименовать" Command="{Binding RenameEventCommand}"/>
                                            <MenuItem Header="Объединить…" Command="{Binding MergeEventCommand}"/>
                                            <MenuItem Header="Заметка…" Command="{Binding EditEventNotesCommand}"/>
                                            <MenuItem Header="Показать это событие в библиотеке" Command="{Binding ShowEventPhotosCommand}"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type models:ArchiveYearItem}" ItemsSource="{Binding Events}">
                                            <StackPanel Orientation="Horizontal" Margin="4,5">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CountDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="8,3,0,0"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type models:EventGroupItem}">
                                            <Grid Margin="4,5" MinWidth="250">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="64" Height="48" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7">
                                                    <Image Source="{Binding RepresentativeThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=180}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="7,0,2,0">
                                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DateRangeDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding PeopleDisplay}" Foreground="{StaticResource TertiaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </DockPanel>
                        </Border>

                        <ListBox x:Name="EventPhotosList" Grid.Column="1" ItemsSource="{Binding EventPhotos}" SelectedItem="{Binding SelectedEventPhoto}"
                                 SelectionMode="Extended" MouseDoubleClick="PhotoList_MouseDoubleClick" PreviewMouseLeftButtonDown="EventPhotosList_PreviewMouseLeftButtonDown" PreviewMouseMove="EventPhotosList_PreviewMouseMove" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                                 BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Просмотр" Click="OpenViewer_Click"/>
                                    <MenuItem Header="Проводник" Command="{Binding ShowEventPhotoInExplorerCommand}"/>
                                    <MenuItem Header="Открыть" Command="{Binding OpenEventPhotoCommand}"/>
                                    <MenuItem Header="Сделать обложкой" Command="{Binding SetEventCoverCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Переименовать событие" Command="{Binding RenameEventCommand}"/>
                                    <MenuItem Header="Объединить событие…" Command="{Binding MergeEventCommand}"/>
                                    <MenuItem Header="Заметка…" Command="{Binding EditEventNotesCommand}"/>
                                    <MenuItem Header="Разделить событие здесь…" Command="{Binding SplitEventCommand}"/>
                                    <MenuItem Header="Показать это событие в библиотеке" Command="{Binding ShowEventPhotosCommand}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="124"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="102" Height="72" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=240}" Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,4">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource TertiaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding CameraDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="4">
                                            <TextBlock Text="{Binding CaptureDateDisplay}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DimensionsDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding FileSizeDisplay}" Foreground="{StaticResource TertiaryTextBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceSecondaryBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Событие" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding SelectedEventGroup.DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedEventGroup.DateRangeDisplay}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding SelectedEventGroup.ConfidenceDisplay}" Foreground="{StaticResource SuccessTextBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedEventGroup.LocationDisplay}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedEventGroup.PeopleDisplay}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding SelectedEventGroup.NotesDisplay}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding SelectedEventGroup.CoverDisplay}" Foreground="{StaticResource TertiaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Переименовать" Command="{Binding RenameEventCommand}" FontWeight="SemiBold"/>
                                        <Button Content="Объединить…" Command="{Binding MergeEventCommand}"/>
                                        <Button Content="Заметка…" Command="{Binding EditEventNotesCommand}"/>
                                        <Button Content="Разделить здесь…" Command="{Binding SplitEventCommand}" ToolTip="Новое событие начнётся с выбранного фото"/>
                                    </WrapPanel>
                                    <Button Content="Показать это событие в библиотеке" Command="{Binding ShowEventPhotosCommand}" Margin="3,4"/>

                                    <Separator Margin="0,12,0,8"/>
                                    <TextBlock Text="Выбранное фото" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                    <Border Height="260" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                        <Image Source="{Binding SelectedEventPhoto.FullPath, Converter={StaticResource ImageConverter}, ConverterParameter=1100}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedEventPhoto.FileName}" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedEventPhoto.CaptureDateDisplay}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedEventPhoto.FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Просмотр" Click="OpenViewer_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                                        <Button Content="Проводник" Command="{Binding ShowEventPhotoInExplorerCommand}"/>
                                        <Button Content="Открыть" Command="{Binding OpenEventPhotoCommand}"/>
                                        <Button Content="Сделать обложкой" Command="{Binding SetEventCoverCommand}"/>
                                    </WrapPanel>

                                    <Border Style="{StaticResource InfoBorderStyle}" Margin="0,12,0,0">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="Переименование, объединение и drag&amp;drop меняют только каталог SQLite. Ручные границы события сохраняются при новом анализе."/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Хронология" ToolTip="Хронология · Ctrl+7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                        <DockPanel LastChildFill="False">
                            <StackPanel>
                                <TextBlock Text="Хронология" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TimelineSummaryText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Год → месяц → фотографии" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="240"/>
                            <ColumnDefinition Width="*" MinWidth="420"/>
                            <ColumnDefinition Width="330" MinWidth="300"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0" Background="{StaticResource PanelBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="По времени" Style="{StaticResource SectionLabelStyle}" Margin="12,10,12,6"/>
                                <TreeView x:Name="TimelineTree" ItemsSource="{Binding TimelineYears}" BorderThickness="0" SelectedItemChanged="TimelineTree_SelectedItemChanged">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type models:TimelineYearItem}" ItemsSource="{Binding Months}">
                                            <StackPanel Orientation="Horizontal" Margin="5,5">
                                                <TextBlock Text="{Binding Year}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="{Binding PhotoCount, StringFormat={} · {0:N0} фото}" Foreground="{StaticResource SecondaryTextBrush}" Margin="7,2,0,0"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type models:TimelineMonthItem}">
                                            <Grid Margin="5,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="46" Height="36" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                                                    <Image Source="{Binding RepresentativeThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=120}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="TimelinePhotosList" Grid.Column="1" ItemsSource="{Binding TimelinePhotos}" SelectedItem="{Binding SelectedTimelinePhoto}" BorderThickness="0"
                                 MouseDoubleClick="PhotoList_MouseDoubleClick" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Открыть просмотрщик" Click="OpenViewer_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                        <Border Width="102" Height="72" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=240}" Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,4">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource TertiaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding FavoriteDisplay}" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding RatingStars}" Foreground="{StaticResource AccentBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="4">
                                            <TextBlock Text="{Binding CaptureDateDisplay}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DimensionsDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceSecondaryBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Выбранная фотография" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                                    <Border Height="300" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                        <Image Source="{Binding SelectedTimelinePhoto.FullPath, Converter={StaticResource ImageConverter}, ConverterParameter=1200}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedTimelinePhoto.FileName}" Style="{StaticResource InspectorHeaderStyle}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding SelectedTimelinePhoto.CaptureDateDisplay}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SelectedTimelinePhoto.CameraDisplay}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTimelinePhoto.RatingDisplay}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SelectedTimelinePhoto.FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <Button Content="Открыть просмотрщик" Click="OpenViewer_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0" ToolTip="Space"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Организация" ToolTip="Организация · Ctrl+8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="230"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Новый архив:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="3,0,7,0"/>
                            <TextBox Grid.Column="1" Text="{Binding OrganizationDestinationRoot, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" MinWidth="450"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Выбрать папку…" Click="ChooseOrganizationRoot_Click"/>
                                <Button Content="Построить Preview" Command="{Binding BuildOrganizationPlanCommand}" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <WrapPanel>
                                    <CheckBox Content="Разрешить дату файла fallback" IsChecked="{Binding OrganizationUseFallbackDates}" Margin="4,4,16,4"
                                              ToolTip="По умолчанию автоматически выбираются только доверенные даты: EXIF и ручные даты каталога. Включайте fallback только если доверяете файловым датам."/>
                                    <CheckBox Content="Дата в имени файла" IsChecked="{Binding OrganizationIncludeDateInFileName}" Margin="4,4,16,4"
                                              ToolTip="Добавляет перед исходным именем только календарную дату: 2016-08-18_IMG_0133.JPG. Время в имя не добавляется."/>
                                    <CheckBox Content="Имена людей в имени файла" IsChecked="{Binding OrganizationIncludeNamedPeopleInFileName}" Margin="4"
                                              ToolTip="Добавляет только вручную именованных людей из актуального анализа лиц. Безымянные и автоматические группы в имя не попадают."/>
                                </WrapPanel>
                                <TextBlock Margin="4,2,4,4" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                                           Text="Структура: Год → мес или мес-мес — событие. Файл: дата_исходное имя — именованные люди. Время не добавляется; исходное имя сохраняется."/>
                                <TextBlock Text="{Binding OrganizationSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,3"/>
                                <TextBlock Text="{Binding OrganizationProgressText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Выбрать доверенные даты" Command="{Binding SelectTrustedOrganizationCommand}"/>
                                <Button Content="Снять все галочки" Command="{Binding ClearOrganizationSelectionCommand}"/>
                                <Button Content="Выполнить выбранное" Command="{Binding ExecuteOrganizationPlanCommand}" FontWeight="Bold" Style="{StaticResource DangerButtonStyle}"/>
                                <Button Content="Пауза" Command="{Binding PauseOrganizationCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Продолжить" Command="{Binding ResumeOrganizationCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Стоп" Command="{Binding StopOrganizationCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="520"/>
                            <ColumnDefinition Width="350" MinWidth="320"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="OrganizationPlanGrid" Grid.Column="0" ItemsSource="{Binding OrganizationPlan}" SelectedItem="{Binding SelectedOrganizationPlanItem}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single" HeadersVisibility="Column">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Исходник в Проводнике" Command="{Binding ShowOrganizationSourceCommand}"/>
                                    <MenuItem Header="Папка назначения" Command="{Binding ShowOrganizationTargetCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, Mode=TwoWay}" Width="44"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding DateDisplay}" Width="185" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Событие" Binding="{Binding EventDisplay}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="БЫЛО" Binding="{Binding SourcePath}" Width="*" MinWidth="300" IsReadOnly="True"/>
                                <DataGridTextColumn Header="СТАНЕТ" Binding="{Binding TargetPath}" Width="*" MinWidth="330" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Размер" Binding="{Binding FileSizeDisplay}" Width="95" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceSecondaryBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="13">
                                    <TextBlock Text="Preview выбранного файла" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                    <Border Height="240" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                        <Image Source="{Binding SelectedOrganizationPlanItem.ThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=900}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedOrganizationPlanItem.FileName}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                    <TextBlock Text="{Binding SelectedOrganizationPlanItem.Status}" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SelectedOrganizationPlanItem.StatusDetails}" Foreground="{StaticResource WarningTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="БЫЛО:" FontWeight="Bold" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding SelectedOrganizationPlanItem.SourcePath}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="СТАНЕТ:" FontWeight="Bold" Margin="0,9,0,2"/>
                                    <TextBlock Text="{Binding SelectedOrganizationPlanItem.TargetPath}" FontSize="12" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button Content="Исходник в Проводнике" Command="{Binding ShowOrganizationSourceCommand}"/>
                                        <Button Content="Папка назначения" Command="{Binding ShowOrganizationTargetCommand}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource WarningBorderStyle}" Margin="0,12,0,0">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}"
                                                   Text="Папки: год → месяц/диапазон месяцев + событие. Имена файлов могут включать дату и только подтверждённых именованных людей. Конфликты не перезаписываются."/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SurfaceSecondaryBrush}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel LastChildFill="False" Grid.Row="0" Margin="9,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Журнал перемещений / Undo" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                    <Button Content="Обновить журнал" Command="{Binding RefreshOrganizationHistoryCommand}"/>
                                    <Button Content="UNDO выбранного" Command="{Binding UndoOrganizationMoveCommand}" FontWeight="SemiBold"/>
                                    <Button Content="Показать файл" Command="{Binding ShowOrganizationMoveCommand}"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Undo проверяет SHA-256 и никогда не перезаписывает существующий файл." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="OrganizationMovesGrid" Grid.Row="1" ItemsSource="{Binding OrganizationMoves}" SelectedItem="{Binding SelectedOrganizationMove}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Показать файл" Command="{Binding ShowOrganizationMoveCommand}"/>
                                        <MenuItem Header="UNDO выбранного" Command="{Binding UndoOrganizationMoveCommand}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Когда" Binding="{Binding DateDisplay}" Width="145"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="170"/>
                                    <DataGridTextColumn Header="Было" Binding="{Binding OriginalPath}" Width="*" MinWidth="250"/>
                                    <DataGridTextColumn Header="Стало" Binding="{Binding NewPath}" Width="*" MinWidth="270"/>
                                    <DataGridTextColumn Header="Размер" Binding="{Binding FileSizeDisplay}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Карантин / Undo" ToolTip="Карантин / Undo · Ctrl+9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                        <DockPanel LastChildFill="False">
                            <StackPanel>
                                <TextBlock Text="{Binding QuarantineSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="Журнал безопасных переносов. Undo сверяет SHA-256 и не перезаписывает существующие файлы."
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshQuarantineCommand}" Margin="12,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="480"/>
                            <ColumnDefinition Width="350" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="QuarantineActionsList" Grid.Column="0" ItemsSource="{Binding QuarantineActions}" SelectedItem="{Binding SelectedQuarantineAction}" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                                 BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Показать в Проводнике" Command="{Binding ShowQuarantineInExplorerCommand}"/>
                                    <MenuItem Header="Открыть" Command="{Binding OpenQuarantineFileCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="UNDO — вернуть на исходное место" Command="{Binding UndoQuarantineCommand}"/>
                                    <MenuItem Header="Удалить навсегда" Command="{Binding PermanentDeleteQuarantineCommand}" Visibility="{Binding AllowPermanentDelete, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource DangerMenuItemStyle}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding OriginalPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding QuarantinePath}" Foreground="{StaticResource TertiaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                            <TextBlock Text="{Binding CreatedDisplay}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusDisplay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceSecondaryBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Выбранная операция" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                                    <Border Height="270" Background="{StaticResource ImageWellBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                        <Image Source="{Binding SelectedQuarantineAction.CurrentPath, Converter={StaticResource ImageConverter}, ConverterParameter=1200}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedQuarantineAction.FileName}" Style="{StaticResource InspectorHeaderStyle}"/>
                                    <TextBlock Text="{Binding SelectedQuarantineAction.StatusDisplay}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Исходный путь:" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,2"/>
                                    <TextBlock Text="{Binding SelectedQuarantineAction.OriginalPath}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Карантин:" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding SelectedQuarantineAction.QuarantinePath}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedQuarantineAction.FileSizeDisplay}" Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Показать в Проводнике" Command="{Binding ShowQuarantineInExplorerCommand}"/>
                                        <Button Content="Открыть" Command="{Binding OpenQuarantineFileCommand}"/>
                                    </StackPanel>
                                    <Button Content="UNDO — вернуть на исходное место" Command="{Binding UndoQuarantineCommand}"
                                            FontWeight="SemiBold" Padding="12,8" Margin="0,14,0,0"/>
                                    <Button Content="Удалить навсегда" Command="{Binding PermanentDeleteQuarantineCommand}"
                                            Visibility="{Binding AllowPermanentDelete, Converter={StaticResource BoolToVisibility}}"
                                            FontWeight="Bold" Padding="12,9" Margin="0,14,0,0" Style="{StaticResource DangerButtonStyle}"/>
                                    <Border Style="{StaticResource DangerBorderStyle}" Margin="0,14,0,0">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DangerTextBrush}"
                                                   Text="Удаление доступно только после временного разрешения в «Настройках» и двух подтверждений. Автоочистки нет."/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Настройки" ToolTip="Настройки · Ctrl+0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22" MaxWidth="850" HorizontalAlignment="Left">
                        <TextBlock Text="Безопасность" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,14"/>
                        <Border Background="{StaticResource DangerSurfaceBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Опасные действия" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}"/>
                                <TextBlock Text="По умолчанию используется обратимый карантин. Окончательное удаление выключено." TextWrapping="Wrap" Margin="0,7,0,12"/>
                                <CheckBox Content="Разрешить окончательное удаление файлов ИЗ КАРАНТИНА в этой сессии"
                                          IsChecked="{Binding AllowPermanentDelete}" FontWeight="SemiBold"/>
                                <TextBlock Text="Разрешение не сохраняется между запусками. Перед удалением — два подтверждения и повторная проверка SHA-256." Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SuccessSurfaceBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Что остаётся защищённым" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="• Анализ не удаляет оригиналы.\n• Удаление возможно только из карантина.\n• Организация всегда начинается с Preview и проверки SHA-256.\n• Карантин и Undo остаются основным безопасным workflow." TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Экспорт каталога" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Сохранить независимый отчёт с путями, датами, камерами, событиями, людьми, SHA-256, точными дублями, Quality Score, GPS и состоянием файлов. Доступны JSON и CSV (UTF-8)."
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                                <Button Content="Экспортировать метаданные…" Click="ExportCatalog_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="О программе" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Photo Archive Manager" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="Версия: 1.7.1" Margin="0,6,0,0"/>
                                <TextBlock Text="Разработчик: Привалов Олег" Margin="0,4,0,0"/>
                                <TextBlock Text="Дата создания проекта: 01.09.2026" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
