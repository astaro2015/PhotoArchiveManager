                                    <MenuItem Header="В карантин" IsCheckable="True" IsChecked="{Binding SelectedBurstFile.IsMarkedForQuarantine, Mode=TwoWay}" IsEnabled="{Binding SelectedBurstFile.CanMarkForQuarantine}"/>
