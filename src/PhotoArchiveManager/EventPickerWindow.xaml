<Window x:Class="PhotoArchiveManager.EventPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/PhotoArchiveManager.ico"
        Title="Объединить события" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="С каким событием объединить выбранное?" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <ComboBox Grid.Row="1" Margin="0,14,0,0"
                  ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                  DisplayMemberPath="HeaderText"/>
        <TextBlock Grid.Row="2" Margin="0,14,0,0" Text="Название итогового события" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Grid.Row="3" Margin="0,6,0,0" MaxLength="160"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" MinWidth="92" IsCancel="True" Margin="0"/>
            <Button Content="Объединить" MinWidth="100" Margin="8,0,0,0" IsDefault="True"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
