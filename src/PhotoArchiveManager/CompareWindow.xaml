<Window x:Class="PhotoArchiveManager.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/PhotoArchiveManager.ico"
        Title="Сравнение похожих фотографий — Photo Archive Manager"
        Width="1500" Height="880" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Text="Синхронное сравнение" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="{Binding HeaderText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Вписать" Click="Fit_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="100%" Click="Zoom100_Click" FontWeight="SemiBold"/>
                    <Button Content="−" Click="ZoomOut_Click" FontSize="16" Width="36" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Slider Width="150" Minimum="0.05" Maximum="4" Value="{Binding Zoom, Mode=TwoWay}" TickFrequency="0.05" Margin="6,0"/>
                    <Button Content="+" Click="ZoomIn_Click" FontSize="16" Width="36" Style="{StaticResource ToolbarButtonStyle}"/>
                    <TextBlock Text="{Binding ZoomDisplay}" Width="62" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}"
                       Text="Масштаб и позиция синхронизированы. Ctrl + колесо меняет общий масштаб; изображение можно таскать левой кнопкой мыши. 100% — один пиксель файла на один логический пиксель WPF. Quality Score v3.3 учитывает технические дефекты и качество основных лиц; вероятно закрытые глаза проверяются локальной консервативной OpenCV-эвристикой и штрафуются только при достаточной уверенности. Это не оценка сюжета или ценности снимка."/>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="8">
            <ItemsControl ItemsSource="{Binding Photos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="410" Margin="5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RecommendedDisplay}" Foreground="{StaticResource SuccessTextBrush}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DimensionsDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding QualityDisplay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="Quality" Foreground="{StaticResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" Height="600" Margin="8" Background="#15171A"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Loaded="ImageScrollViewer_Loaded"
                                              Unloaded="ImageScrollViewer_Unloaded"
                                              ScrollChanged="ImageScrollViewer_ScrollChanged"
                                              PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                                              PreviewMouseLeftButtonDown="ImageScrollViewer_MouseLeftButtonDown"
                                              PreviewMouseLeftButtonUp="ImageScrollViewer_MouseLeftButtonUp"
                                              PreviewMouseMove="ImageScrollViewer_MouseMove">
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Image Stretch="Fill" SnapsToDevicePixels="True">
                                            <Image.Width>
                                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                    <Binding Path="DisplayPixelWidth"/>
                                                    <Binding Path="DataContext.Zoom" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                                </MultiBinding>
                                            </Image.Width>
                                            <Image.Height>
                                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                                    <Binding Path="DisplayPixelHeight"/>
                                                    <Binding Path="DataContext.Zoom" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                                </MultiBinding>
                                            </Image.Height>
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource OrientedImageConverter}">
                                                    <Binding Path="FullPath"/>
                                                    <Binding Path="Orientation"/>
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Margin="10,3,10,10">
                                    <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                    <TextBlock Text="{Binding QualityComponentsDisplay}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FaceDisplay}" Foreground="{StaticResource SuccessTextBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding BlinkWarningDisplay}" Visibility="{Binding HasBlinkWarning, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource WarningTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding QualityNotes}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,5,0,0" FontSize="12">
                                        <Run Text="Сходство: "/><Run Text="{Binding SimilarityDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" · "/><Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding CaptureDateDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
