                                    <TextBlock Text="{Binding SelectedVisualDuplicateFile.RecommendedDisplay}" Foreground="{StaticResource SuccessTextBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock FontWeight="SemiBold"><Run Text="Сходство: "/><Run Text="{Binding SelectedVisualDuplicateFile.SimilarityDisplay, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Margin="0,8,0,0" FontWeight="Bold" FontSize="15"><Run Text="Quality Score: "/><Run Text="{Binding SelectedVisualDuplicateFile.QualityDisplay, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Text="{Binding SelectedVisualDuplicateFile.QualityComponentsDisplay}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedVisualDuplicateFile.FaceDisplay}" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedVisualDuplicateFile.QualityNotes}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedVisualDuplicateFile.CaptureDateDisplay}" Margin="0,9,0,0"/>
                                    <TextBlock Text="{Binding SelectedVisualDuplicateFile.DimensionsDisplay}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SelectedVisualDuplicateFile.FileSizeDisplay}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SelectedVisualDuplicateFile.CameraDisplay}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Показать в Проводнике" Command="{Binding ShowVisualInExplorerCommand}"/>
                                        <Button Content="Открыть" Command="{Binding OpenVisualFileCommand}"/>
