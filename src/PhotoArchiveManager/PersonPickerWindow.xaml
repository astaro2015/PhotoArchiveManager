<Window x:Class="PhotoArchiveManager.PersonPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/PhotoArchiveManager.ico"
        Title="Выбор человека" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="1" Margin="0,14,0,0"
                  ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                  DisplayMemberPath="DisplayName"/>
        <TextBlock Grid.Row="2" Margin="0,9,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                   Text="Меняется только локальная запись в каталоге лиц. Фотографии не перемещаются и не изменяются."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" MinWidth="92" IsCancel="True" Margin="0"/>
            <Button Content="OK" MinWidth="92" Margin="8,0,0,0" IsDefault="True"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
