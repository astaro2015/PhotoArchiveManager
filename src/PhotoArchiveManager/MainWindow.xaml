                                    <Button Content="В карантин отмеченные" Command="{Binding QuarantineMarkedVisualCommand}" FontWeight="SemiBold" Margin="3,2" Style="{StaticResource DangerButtonStyle}"/>
                                    <Button Content="Сбросить ручные отметки" Command="{Binding ClearVisualReviewCommand}" Margin="3,2"/>
                                    <Border Style="{StaticResource WarningBorderStyle}" Margin="0,12,0,0">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}"
