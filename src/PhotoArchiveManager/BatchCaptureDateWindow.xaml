<Window x:Class="PhotoArchiveManager.BatchCaptureDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/PhotoArchiveManager.ico"
        Title="Дата для выбранных фотографий" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,16" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                   Text="Меняется только каталог PAM. EXIF, дата файла Windows и сами фотографии остаются без изменений."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Дата" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="DateBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Время" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="TimeBox" MaxLength="8"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="PreserveTimeBox" Grid.Row="3" Margin="0,14,0,0" IsChecked="True"
                  Checked="PreserveTime_Changed" Unchecked="PreserveTime_Changed"
                  Content="Сохранить индивидуальное время каждого снимка"/>
        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="{StaticResource DangerTextBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" MinWidth="95" Margin="0"/>
            <Button Content="Применить" IsDefault="True" MinWidth="105" Margin="8,0,0,0"
                    Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
