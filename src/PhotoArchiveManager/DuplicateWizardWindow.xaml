<Window x:Class="PhotoArchiveManager.DuplicateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PhotoArchiveManager.Converters"
        Title="Мастер точных дублей" Icon="Assets/PhotoArchiveManager.ico"
        Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources><conv:FilePathToBitmapConverter x:Key="ImageConverter"/></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Мастер точных дублей" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,7,0,12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Text="Для байт-в-байт одинаковых файлов качество изображения одинаково. PAM рекомендует, какую копию оставить, только по аккуратности пути/имени и сохранности каталога. Мастер ничего не перемещает сам — после выбора вы вернётесь в группу и отдельно подтвердите карантин."/>
        </StackPanel>
        <DataGrid x:Name="RecommendationsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Группа" Binding="{Binding Header}" Width="190"/>
                <DataGridTextColumn Header="Рекомендуется оставить" Binding="{Binding KeeperPath}" Width="*"/>
                <DataGridTextColumn Header="Почему" Binding="{Binding Reason}" Width="240"/>
                <DataGridTextColumn Header="Экономия" Binding="{Binding Savings}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                       Text="После перехода проверьте путь и только затем нажимайте «Оставить выбранный, остальные в карантин»."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Закрыть" IsCancel="True" MinWidth="105"/>
                <Button Content="Перейти к рекомендации" Click="Apply_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="180"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
