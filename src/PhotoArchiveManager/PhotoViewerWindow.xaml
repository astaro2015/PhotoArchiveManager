<Window x:Class="PhotoArchiveManager.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PhotoArchiveManager.Converters"
        Title="Просмотр фотографии · Photo Archive Manager"
        Icon="Assets/PhotoArchiveManager.ico"
        Width="1480" Height="920" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="#111214"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <conv:FilePathToBitmapConverter x:Key="ImageConverter"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Background" Value="#26282C"/>
            <Setter Property="BorderBrush" Value="#3B3D42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#34373C"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="FilmstripRow" Height="118"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1D20" BorderBrush="#323438" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="−" Click="ZoomOut_Click" ToolTip="Уменьшить · -"/>
                    <Button x:Name="ZoomTextButton" Content="100%" Click="Fit_Click" ToolTip="Подогнать по окну · F" MinWidth="72"/>
                    <Button Content="+" Click="ZoomIn_Click" ToolTip="Увеличить · +"/>
                    <Button Content="1:1" Click="ActualSize_Click" ToolTip="Масштаб 100% · 1"/>
                    <Button Content="По окну" Click="Fit_Click" ToolTip="Подогнать по окну · F"/>
                    <Button Content="Инфо" Click="ToggleInfo_Click" ToolTip="Показать/скрыть сведения · I"/>
                    <Button Content="Плёнка" Click="ToggleFilmstrip_Click" ToolTip="Показать/скрыть соседние кадры · T"/>
                    <Button Content="На весь экран" Click="ToggleFullscreen_Click" ToolTip="Полный экран · F11"/>
                    <Button Content="Закрыть" Click="Close_Click" ToolTip="Esc"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="‹" Click="Previous_Click" ToolTip="Предыдущее · ←" MinWidth="46"/>
                    <Button Content="›" Click="Next_Click" ToolTip="Следующее · →" MinWidth="46"/>
                </StackPanel>
                <TextBlock x:Name="CounterText" Foreground="#A8ABB2" VerticalAlignment="Center" Margin="12,0" FontSize="13"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#0D0E10" ClipToBounds="True">
            <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PanningMode="Both" PreviewMouseWheel="ImageScroll_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ImageScroll_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="ImageScroll_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="ImageScroll_PreviewMouseMove"
                          SizeChanged="ImageScroll_SizeChanged">
                <Grid x:Name="ImageHost" Background="#0D0E10">
                    <Image x:Name="PhotoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border x:Name="InfoBorder" Grid.Row="2" Background="#1B1D20" BorderBrush="#323438" BorderThickness="0,1,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="DetailsText" DockPanel.Dock="Right" Foreground="#9A9DA4" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" MaxWidth="620" TextTrimming="CharacterEllipsis"/>
                <StackPanel>
                    <TextBlock x:Name="FileNameText" Foreground="#F5F5F7" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DateText" Foreground="#A8ABB2" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox x:Name="Filmstrip" Grid.Row="3" Background="#151619" BorderThickness="0" Foreground="#F5F5F7"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="Filmstrip_SelectionChanged" PreviewMouseWheel="Filmstrip_PreviewMouseWheel">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="112" Margin="4,7">
                        <Border Width="104" Height="76" Background="#23252A" BorderBrush="#3A3D43" BorderThickness="1" CornerRadius="6">
                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImageConverter}, ConverterParameter=220}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="{Binding FileName}" Foreground="#D7D9DD" FontSize="10" TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
