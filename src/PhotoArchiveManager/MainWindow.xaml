                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Content="Пауза оценки" Command="{Binding PauseQualityAnalysisCommand}"/>
                                        <Button Content="Продолжить" Command="{Binding ResumeQualityAnalysisCommand}"/>
                                        <Button Content="Стоп" Command="{Binding StopQualityAnalysisCommand}"/>
