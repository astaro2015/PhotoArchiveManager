<Window x:Class="PhotoArchiveManager.BatchEventAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/PhotoArchiveManager.ico"
        Title="Назначить событие" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                   Text="Выбранные фото будут связаны с одним существующим событием. Файлы на диске не перемещаются."/>
        <ComboBox Grid.Row="2" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" DisplayMemberPath="HeaderText"/>
        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                   Text="Если фото уже входят в другие события, их прежние границы будут пересчитаны; ручные события останутся закреплёнными."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" MinWidth="95" Margin="0"/>
            <Button Content="Назначить" IsDefault="True" MinWidth="105" Margin="8,0,0,0"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
