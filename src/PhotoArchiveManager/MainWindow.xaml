                        <ListBox x:Name="BurstFilesList" Grid.Column="1" ItemsSource="{Binding SelectedBurstGroup.Files}" SelectedItem="{Binding SelectedBurstFile}" MouseDoubleClick="PhotoList_MouseDoubleClick" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                                 BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
