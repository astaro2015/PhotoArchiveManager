                                            <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding DimensionsDisplay}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding FileSizeDisplay}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ManualKeeperDisplay}" Foreground="{StaticResource SuccessTextBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding RecommendedDisplay}" Foreground="{StaticResource SuccessTextBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding QualityDisplay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
